{



    "version": 4,
    "env": {

        "pvsneslibIncludes": [
            "C:/pvsneslib/pvsneslib/include/**",
            "C:/pvsneslib/devkitsnes/include/**"
        ],

        "projectIncludes": [
            "${workspaceFolder}/src/**",
            "${workspaceFolder}/include/**",
            "${workspaceFolder}/res/**"
        ]
    },
    "configurations": [
        {
            "name": "SNES (PVSnesLib)",
            "includePath": [
                "${projectIncludes}",
                "${pvsneslibIncludes}"
            ],
            "defines": [
                "__SNES__",
                "__TCC__"
            ],
            "cStandard": "c99",
            "intelliSenseMode": "windows-gcc-x86",
            "browse": {
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            }
        }
    ]
}
